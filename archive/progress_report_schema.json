{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evolution Engine Progress Report",
  "description": "Schema for progress_report.json (schema v1.0), generated by AutonomousRunner._generate_progress_report()/_write_extended_report() after each evolution cycle.",
  "type": "object",
  "schema_version": "1.0",
  "required": [
    "generated_at",
    "cycle",
    "schema_version",
    "summary",
    "fitness",
    "level",
    "retrain",
    "diversity",
    "time_breakdown",
    "errors",
    "trends",
    "latest_cycle",
    "resource_usage"
  ],
  "additionalProperties": false,
  "$defs": {
    "trend_stats": {
      "type": "object",
      "description": "Rolling-window trend statistics for a scalar metric (e.g. fitness, level).",
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": ["number", "null"],
          "description": "Most recent value in the window."
        },
        "avg": {
          "type": ["number", "null"],
          "description": "Average value across the window."
        },
        "min": {
          "type": ["number", "null"],
          "description": "Minimum value across the window."
        },
        "max": {
          "type": ["number", "null"],
          "description": "Maximum value across the window."
        },
        "trend": {
          "type": "string",
          "enum": ["improving", "regressing", "stable", "unknown"],
          "description": "Qualitative trend direction over the window."
        },
        "window_size": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of samples used to compute the trend."
        }
      }
    }
  },
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the report was generated."
    },
    "cycle": {
      "type": "integer",
      "minimum": 0,
      "description": "Cycle number this report was generated for."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of this report schema."
    },
    "summary": {
      "type": "object",
      "description": "High-level run summary.",
      "additionalProperties": false,
      "properties": {
        "best_fitness": {"type": "number"},
        "best_level": {"type": "integer", "minimum": 0},
        "cycles_completed": {"type": "integer", "minimum": 0},
        "total_errors": {"type": "integer", "minimum": 0},
        "uptime_seconds": {"type": "number", "minimum": 0},
        "start_timestamp": {"type": "string"}
      }
    },
    "fitness": {
      "type": "object",
      "description": "Fitness trajectory and trend.",
      "additionalProperties": false,
      "properties": {
        "trajectory": {
          "type": "array",
          "items": {"type": "number"},
          "description": "Recent fitness values (up to the last 20)."
        },
        "trend": {"$ref": "#/$defs/trend_stats"},
        "best_ever": {"type": "number"}
      }
    },
    "level": {
      "type": "object",
      "description": "Curriculum level progression and trend.",
      "additionalProperties": false,
      "properties": {
        "progression_history": {
          "type": "array",
          "items": {"type": "integer"},
          "description": "Recent level values."
        },
        "trend": {"$ref": "#/$defs/trend_stats"}
      }
    },
    "retrain": {
      "type": "object",
      "description": "Retrain validation-loss history and counts.",
      "additionalProperties": false,
      "properties": {
        "val_loss_history": {
          "type": "array",
          "items": {"type": ["number", "null"]}
        },
        "last_val_loss": {"type": ["number", "null"]},
        "retrain_count": {"type": "integer", "minimum": 0}
      }
    },
    "diversity": {
      "type": "object",
      "description": "Population/quality-diversity metrics.",
      "additionalProperties": false,
      "properties": {
        "unique_individuals": {"type": ["integer", "null"], "minimum": 0},
        "qd_occupied": {"type": ["integer", "null"], "minimum": 0},
        "qd_total": {"type": ["integer", "null"], "minimum": 0},
        "diversity_score": {"type": ["number", "null"]},
        "latest_diversity": {"type": ["number", "null"]}
      }
    },
    "time_breakdown": {
      "type": "object",
      "description": "Per-cycle and cumulative timing breakdown.",
      "additionalProperties": false,
      "properties": {
        "evolution_seconds": {"type": ["number", "null"], "minimum": 0},
        "retrain_seconds": {"type": ["number", "null"], "minimum": 0},
        "total_cycle_seconds": {"type": ["number", "null"], "minimum": 0},
        "avg_cycle_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "errors": {
      "type": "object",
      "description": "Error counts and breakdown by type.",
      "additionalProperties": false,
      "properties": {
        "total_count": {"type": "integer", "minimum": 0},
        "types": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "consecutive_errors": {"type": "integer", "minimum": 0}
      }
    },
    "trends": {
      "type": "object",
      "description": "Top-level trend summary (backward-compatible mirror of fitness.trend/level.trend).",
      "additionalProperties": false,
      "properties": {
        "fitness": {"$ref": "#/$defs/trend_stats"},
        "level": {"$ref": "#/$defs/trend_stats"}
      }
    },
    "latest_cycle": {
      "type": "object",
      "description": "The raw cycle_metrics dict passed in for the most recent cycle."
    },
    "resource_usage": {
      "type": "object",
      "description": "Disk and population resource usage.",
      "additionalProperties": false,
      "properties": {
        "checkpoint_disk_mb": {"type": "number", "minimum": 0},
        "population_size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
