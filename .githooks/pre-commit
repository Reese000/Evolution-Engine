#!/bin/bash
# Shared pre-commit hook for all Projects repos
# Prevents committing secrets, large files, __pycache__, .pyc, .env, etc.

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check for __pycache__ or .pyc files
if echo "$STAGED_FILES" | grep -qE '(\.pyc$|__pycache__/)'; then
    echo -e "${RED}ERROR: Python bytecode files are staged for commit:${NC}"
    echo "$STAGED_FILES" | grep -E '(\.pyc$|__pycache__/)'
    echo "Add these to .gitignore and unstage them."
    ERRORS=$((ERRORS + 1))
fi

# Check for .env files (but allow .env.example, .env.template, .env.local)
if echo "$STAGED_FILES" | grep -qE '(^|/)\.env$'; then
    echo -e "${RED}ERROR: .env file staged for commit:${NC}"
    echo "$STAGED_FILES" | grep -E '(^|/)\.env$'
    echo "Add .env to .gitignore — never commit secrets."
    ERRORS=$((ERRORS + 1))
fi

# Check for .env.local, .env.development, etc. (not .env.example)
if echo "$STAGED_FILES" | grep -qE '(^|/)\.env\.(local|development|production)$'; then
    echo -e "${RED}ERROR: Environment-specific .env file staged for commit:${NC}"
    echo "$STAGED_FILES" | grep -E '(^|/)\.env\.(local|development|production)$'
    echo "These may contain secrets. Add them to .gitignore."
    ERRORS=$((ERRORS + 1))
fi

# Check for large files (>1MB)
LARGE_FILES=""
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        SIZE=$(stat --format="%s" "$file" 2>/dev/null || stat -f "%z" "$file" 2>/dev/null)
        if [ -n "$SIZE" ] && [ "$SIZE" -gt 1048576 ]; then
            SIZE_MB=$(echo "scale=1; $SIZE / 1048576" | bc 2>/dev/null || echo "$SIZE")
            LARGE_FILES="$LARGE_FILES  $file (${SIZE_MB}MB)\n"
        fi
    fi
done

if [ -n "$LARGE_FILES" ]; then
    echo -e "${YELLOW}WARNING: Large files being committed (>1MB):${NC}"
    echo -e "$LARGE_FILES"
    echo "Consider adding these to .gitignore or using Git LFS."
    echo ""
fi

# Check for common secret patterns in staged files
if echo "$STAGED_FILES" | grep -qE '\.(py|js|ts|tsx|json|yaml|yml|toml|cfg|ini|env)$'; then
    SECRET_FILES=""
    for file in $STAGED_FILES; do
        if [ -f "$file" ] && grep -qE 'sk-[a-zA-Z0-9]{20,}|api_key\s*=\s*["\x27][a-zA-Z0-9]{10,}|secret\s*=\s*["\x27][a-zA-Z0-9]{10,}|password\s*=\s*["\x27][a-zA-Z0-9]{10,}|ghp_[a-zA-Z0-9]{36}|xoxb-|xoxp-|AKIA[0-9A-Z]{16}' "$file" 2>/dev/null; then
            SECRET_FILES="$SECRET_FILES  $file\n"
        fi
    done

    if [ -n "$SECRET_FILES" ]; then
        echo -e "${RED}WARNING: Potential secrets detected in staged files:${NC}"
        echo -e "$SECRET_FILES"
        echo "Review these files for hardcoded API keys or credentials."
        echo ""
    fi
fi

# Check for .log files
if echo "$STAGED_FILES" | grep -qE '\.log$'; then
    echo -e "${YELLOW}WARNING: Log files staged for commit:${NC}"
    echo "$STAGED_FILES" | grep -E '\.log$'
    echo "Consider adding *.log to .gitignore."
    echo ""
fi

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}Commit blocked due to $ERRORS error(s). Fix the issues above and try again.${NC}"
    exit 1
fi

exit 0
